# ═══════════════════════════════════════════════════════════════
# 1. 만세력 — 한국천문연구원 공공데이터포털
# ═══════════════════════════════════════════════════════════════
# '음양력 정보'·'특일 정보' 서비스 활용 신청 후 발급받은 일반 인증키.
# URL 인코딩된 키를 붙여넣어도 자동으로 디코딩하여 사용합니다.
# https://www.data.go.kr
KASI_SERVICE_KEY=

# ═══════════════════════════════════════════════════════════════
# 2. 사주 풀이 — LLM 게이트웨이 (OpenRouter 기본 / cheaperinference 예비)
# ═══════════════════════════════════════════════════════════════
# 사용할 프로바이더: openrouter (기본) | cheaperinference
AI_PROVIDER=openrouter

# ── 2-1. OpenRouter (기본) ──
# API 키: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OpenAI 호환 엔드포인트 (기본값 그대로 사용)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# 호출할 모델 ID
OPENROUTER_API_MODEL=upstage/solar-pro4
# OpenRouter 앱 랭킹에 표시될 사이트 주소 (선택)
# OPENROUTER_REFERER=https://golden-pig-saju.app

# ── 2-2. cheaperinference (예비 — AI_PROVIDER=cheaperinference로 전환 시 사용) ──
CHEAPERINFERENCE_API_KEY=
CHEAPERINFERENCE_BASE_URL=https://api.cheaperinference.ai/v1
CHEAPERINFERENCE_API_MODEL=gemini-3.7-flash

# ═══════════════════════════════════════════════════════════════
# 3. 메일 발송 — Gmail SMTP ("메일로 받아보기" 기능)
# ═══════════════════════════════════════════════════════════════
# 발송용 Gmail 주소와 '앱 비밀번호' 16자리.
# 일반 비밀번호로는 SMTP가 차단됨 — 2단계 인증 활성화 후 발급:
# https://myaccount.google.com/apppasswords
MAIL_GMAIL_USER=
MAIL_GMAIL_APP_PASSWORD=

# ═══════════════════════════════════════════════════════════════
# 4. 로봇 방지 — Cloudflare Turnstile (메일 발송 보호)
# ═══════════════════════════════════════════════════════════════
# 위젯 생성: Cloudflare 대시보드 → Turnstile → Add site
# (위젯 Hostnames에 사용 도메인·localhost 등록 필요 — 미등록 시 110200 에러)
# 미설정 시 위젯/검증이 자동으로 비활성화됩니다.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 클라이언트 위젯 렌더용 공개 키 (SITE_KEY와 동일한 값)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# 사이트검증 hostname 허용목록(쉼표 구분).
# 로컬 개발: localhost,127.0.0.1 / 프로덕션: 배포 도메인만 (localhost 포함 금지)
# 미설정 시 메일 발송이 fail-closed(403)로 차단됩니다.
TURNSTILE_HOSTNAMES=

# ═══════════════════════════════════════════════════════════════
# 5. 클라이언트 공개 값 (브라우저 번들에 포함되어도 안전한 것만)
# ═══════════════════════════════════════════════════════════════
# 결과 화면 등에 표시할 모델 라벨
NEXT_PUBLIC_AI_MODEL=upstage/solar-pro4
