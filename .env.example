# 공공데이터포털 (한국천문연구원) — 일반 인증키 (디코딩된 값)
# '음양력 정보' 및 '특일 정보' 서비스 각각 활용 신청 후 발급받은 키를 붙여넣으세요.
# URL 인코딩된 키를 붙여넣어도 자동으로 디코딩하여 사용합니다.
KASI_SERVICE_KEY=

# ── LLM 게이트웨이 ─────────────────────────────────────────────
# 사용할 프로바이더: openrouter (기본) | cheaperinference
AI_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=upstage/solar-pro4

# cheaperinference (예비)
CHEAPERINFERENCE_API_KEY=
CHEAPERINFERENCE_BASE_URL=https://api.cheaperinference.ai/v1
AI_MODEL=gemini-3.7-flash

# 결과 화면에 표시할 모델 라벨 (클라이언트 노출용)
NEXT_PUBLIC_AI_MODEL=upstage/solar-pro4

# ── 메일 발송 (Gmail SMTP) ───────────────────────────────────────
# 2단계 인증 활성화 후 발급한 앱 비밀번호 16자리 (일반 비밀번호 X)
# https://myaccount.google.com/apppasswords
MAIL_GMAIL_USER=
MAIL_GMAIL_APP_PASSWORD=

# ── Cloudflare Turnstile (로봇 방지) ─────────────────────────────
# Cloudflare 대시보드 → Turnstile → Add site에서 발급
# 미설정 시 위젯/검증이 비활성화되고, 설정 시 메일 발송에 인증 필수
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
